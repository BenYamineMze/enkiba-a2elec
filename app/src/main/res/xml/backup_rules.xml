<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles de sauvegarde automatique pour Android 6 à 11 (API 23 à 30).
    Android 12 et plus lisent data_extraction_rules.xml à la place.

    Liste blanche : dès qu'un <include> est présent, tout le reste est exclu.
    On ne garde que les préférences d'interface (enkiba_ui.xml : choix du thème).

    Exclus volontairement :
    - user_session_secure.xml (EncryptedSharedPreferences, jetons de session et
      jeux de clés Tink) : la clé maître vit dans l'Android Keystore, qui n'est
      jamais sauvegardé. Restauré ailleurs, ce fichier serait indéchiffrable.
    - __androidx_security_crypto_encrypted_prefs__.xml (fichier de clés par
      défaut de security-crypto), pour la même raison.
    - sync_prefs.xml (curseurs de synchronisation) et la base Room stock.db
      (+ -wal, -shm, -journal) : les lignes « pending » et les curseurs de pull
      appartiennent à l'appareil d'origine ; la base est reconstruite depuis
      Supabase après connexion.
-->
<full-backup-content>
    <include domain="sharedpref" path="enkiba_ui.xml" />
</full-backup-content>
