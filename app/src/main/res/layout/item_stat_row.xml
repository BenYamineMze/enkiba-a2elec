<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/margin_small"
    android:background="@drawable/bg_rounded_white"
    android:layout_marginBottom="@dimen/margin_small"
    android:elevation="2dp"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/tv_product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Clavier mécanique RGB"
        android:textStyle="bold"
        android:textColor="@color/primary_green_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv_product_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Catégorie : Accessoires"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/margin_extra_small">

        <TextView
            android:id="@+id/tv_stock_info"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            tools:text="Stock : 10 / 100"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/img_alert"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:src="@drawable/ic_warning"
            android:visibility="gone"
            tools:visibility="visible"
            app:tint="@color/alert_danger"
            android:contentDescription="@string/content_desc_stock_alert"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_stock"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/progress_bar_height"
        android:progress="10"
        android:max="100"
        android:layout_marginTop="@dimen/margin_extra_small"
        android:progressTint="@color/primary_green_dark"
        android:backgroundTint="@color/progress_background_light_green"
        android:indeterminate="false" />

</LinearLayout>