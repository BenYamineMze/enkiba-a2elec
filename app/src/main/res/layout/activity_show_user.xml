<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_light"
        android:paddingHorizontal="@dimen/padding_default"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingBottom="@dimen/padding_large">

            <ImageView
                android:id="@+id/imgUserPhoto"
                android:layout_width="@dimen/avatar_size_large"
                android:layout_height="@dimen/avatar_size_large"
                android:src="@drawable/ic_person"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:background="@drawable/circle_bg_light"
                android:padding="@dimen/padding_default"
                android:scaleType="centerInside"
                android:contentDescription="@string/content_desc_user_photo"/>

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Jean Dupont"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark"
                android:textSize="22sp"
                android:layout_marginTop="@dimen/padding_default"/>

            <TextView
                android:id="@+id/txtRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/placeholder_role"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="@dimen/padding_default"/>

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/rounded_card"
                android:padding="@dimen/padding_default"
                android:layout_marginHorizontal="@dimen/margin_fields"
                android:layout_marginTop="@dimen/padding_default"
                android:elevation="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_title_info"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="@dimen/margin_fields"/>

                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/placeholder_email"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/margin_small"/>

                <TextView
                    android:id="@+id/txtPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/placeholder_phone"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/margin_small"/>

                <TextView
                    android:id="@+id/txtActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/placeholder_status_active"
                    android:textColor="@color/status_active_green"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="@dimen/padding_large"
                android:layout_marginBottom="@dimen/spacing_xxl"
                android:layout_marginHorizontal="@dimen/padding_large"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/button_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/button_primary_blue"
                    android:textColor="@color/white"
                    android:layout_marginEnd="@dimen/padding_default"
                    app:cornerRadius="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/button_delete"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/alert_danger"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/_nav_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>