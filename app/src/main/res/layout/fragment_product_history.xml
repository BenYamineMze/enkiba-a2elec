<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light_green"
    tools:context=".fragments.ProductHistoryFragment">

    <!-- La liste prend désormais toute la hauteur, le bouton flottera par-dessus -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProductHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/margin_fields"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_product_history"/>

    <!-- Message vide centré (même logique que SalesHistory) -->
    <TextView
        android:id="@+id/txtEmptyProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/message_empty_product_history"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        android:padding="@dimen/margin_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"
        tools:visibility="gone"/>

    <!-- Bouton identique à celui de SalesHistoryFragment -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnExportPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fab_margin_vertical"
        android:layout_marginEnd="@dimen/padding_large"
        android:src="@drawable/ic_pdf"
        app:backgroundTint="@color/primary_green_dark"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/fab_export_pdf_desc"/>

</androidx.constraintlayout.widget.ConstraintLayout>