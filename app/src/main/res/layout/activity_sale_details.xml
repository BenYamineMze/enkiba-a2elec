<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".activities.SaleDetailsActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green_dark"
        android:paddingHorizontal="@dimen/padding_default"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="@string/content_desc_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_sale_details"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/padding_default" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_fields">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/margin_fields"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:padding="@dimen/padding_default"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSaleId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Vente #1"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/primary_green_dark"/>

                    <TextView
                        android:id="@+id/tvSaleDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Date : 10/01/2025"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvSalePayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Paiement : Espèces"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvSaleSeller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Vendu par : Manager"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvSaleTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Total : 15 000 KMF"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green_dark"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="16sp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="@dimen/margin_fields">

                <LinearLayout
                    android:padding="@dimen/padding_default"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_title_client"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green_dark"/>

                    <TextView
                        android:id="@+id/tvSaleClient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Client : Non défini"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="@string/section_title_items"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginBottom="@dimen/margin_small"
                android:textColor="@color/primary_green_dark"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSaleItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_sale_item" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnPrintInvoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_default"
        android:src="@drawable/ic_pdf"
        app:backgroundTint="@color/primary_green_dark"
        app:tint="@color/white"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/content_desc_print_button"/>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/_nav_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>