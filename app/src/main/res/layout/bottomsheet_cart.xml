<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="@dimen/padding_default"
    android:background="@color/background_light_green"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"> <TextView
    android:id="@+id/tvCartTitle"
    android:text="@string/title_your_cart"
    android:textStyle="bold"
    android:textSize="22sp"
    android:textColor="@color/primary_green_dark"
    android:layout_marginBottom="@dimen/margin_small"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:drawableStart="@drawable/ic_cart"
    android:drawablePadding="@dimen/margin_small"
    app:drawableTint="@color/primary_green_dark"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="@dimen/margin_fields"
        android:layout_marginBottom="@dimen/margin_fields"
        app:cardElevation="4dp"
        app:cardCornerRadius="20dp"
        app:strokeColor="@color/stroke_light_green"
        app:strokeWidth="@dimen/stroke_width_default">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cartRecyclerView"
            android:padding="@dimen/margin_fields"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_cart_v"/>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textTotalCart"
        tools:text="Total : 12 500 KMF"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_gravity="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseCart"
        android:text="@string/button_close_cart"
        android:layout_marginTop="@dimen/padding_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/primary_green_dark"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/white"
        android:textColor="@color/white"
        android:paddingVertical="12dp"/>

</LinearLayout>