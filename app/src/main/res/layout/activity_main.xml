<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    tools:context=".activities.AcceuilActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_default"
        android:paddingEnd="@dimen/spacing_default"
        android:paddingBottom="@dimen/margin_fields"
        android:paddingTop="@dimen/spacing_small"
        android:gravity="center_vertical"
        android:elevation="2dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:layout_marginEnd="@dimen/margin_fields"
            android:adjustViewBounds="true"
            android:background="@drawable/circle_bg"
            android:contentDescription="@string/content_desc_app_logo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KARIBU !"
                android:textColor="@color/gray_dark"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Jack Doeson"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:src="@drawable/ic_user"
            android:background="@drawable/circle_bg"
            android:padding="@dimen/padding_extra_small"
            android:scaleType="centerCrop"
            android:contentDescription="@string/content_desc_user_photo"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Carte 1: Reste Stock (Top 5 Stocks) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStockRemaining"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/green_light"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reste stock"
                                android:textColor="@color/green_dark"
                                android:textStyle="bold"
                                android:textSize="18sp"/>

                            <TextView
                                android:id="@+id/txtStockValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="125 unités"
                                android:textColor="@color/black"
                                android:textAlignment="center"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/padding_extra_small"
                                android:layout_marginBottom="@dimen/padding_extra_small"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ Quantité en stock"
                                android:textColor="@color/green_primary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Carte 2: Rupture Stock (Déjà configurée) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardLowStock"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/red_light"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rupture Stocks"
                                android:textColor="@color/red_dark"
                                android:textStyle="bold"
                                android:textSize="18sp"/>

                            <TextView
                                android:id="@+id/txtLowStockValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="3 articles"
                                android:textColor="@color/black"
                                android:textAlignment="center"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/padding_extra_small"
                                android:layout_marginBottom="@dimen/padding_extra_small"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓ Stock limité"
                                android:textColor="@color/red_primary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blocAchats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Carte 3: Achats Virement -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPurchaseTransfer"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/blue_light"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Achats Virement"
                                android:textColor="@color/blue_dark"
                                android:textStyle="bold"
                                android:textSize="16sp"/>

                            <TextView
                                android:id="@+id/txtPurchaseTransfer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="1 500 000 KMF"
                                android:textColor="@color/black"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txtVirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="(3050.00 €)"
                                android:textColor="@color/gray"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ Montant par virement"
                                android:textColor="@color/blue_primary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Carte 4: Achats Espèces -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPurchaseCash"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/green_light_2"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Achats Espèces"
                                android:textColor="@color/green_dark_2"
                                android:textStyle="bold"
                                android:textSize="16sp"/>

                            <TextView
                                android:id="@+id/txtPurchaseCash"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="500 000 KMF"
                                android:textColor="@color/black"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txtEspece"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="(1017.00 €)"
                                android:textColor="@color/gray"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ Montant en espèces"
                                android:textColor="@color/green_primary_2"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blocGains"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Carte 5: Gains Stock -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStockGains"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/yellow_light"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gains Stock"
                                android:textColor="@color/yellow_dark"
                                android:textStyle="bold"
                                android:textSize="16sp"/>

                            <TextView
                                android:id="@+id/txtStockMoneyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="350 000 KMF"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textAlignment="center"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txtArgentStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="(712.00 €)"
                                android:textColor="@color/gray"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ Bénéfices attendus"
                                android:textColor="@color/yellow_primary"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Carte 6: Bénéfices -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBenefits"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_margin="@dimen/spacing_small"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="@dimen/corner_radius_default"
                        app:cardBackgroundColor="@color/blue_light_2"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/spacing_small"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bénéfices"
                                android:textColor="@color/blue_dark_2"
                                android:textStyle="bold"
                                android:textSize="16sp"/>

                            <TextView
                                android:id="@+id/txtBestSellerValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="150 000 KMF"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textAlignment="center"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:id="@+id/txtArgentBenefice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="(305.00 €)"
                                android:textColor="@color/gray"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bilan des ventes"
                                android:textColor="@color/blue_primary_2"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_small"
                android:layout_marginTop="@dimen/spacing_default"
                app:cardCornerRadius="@dimen/corner_radius_default"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_default"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_fields"
                        android:text="Répartition du stock par catégorie"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart"
                        android:layout_width="280dp"
                        android:layout_height="280dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_default"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/_nav_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>