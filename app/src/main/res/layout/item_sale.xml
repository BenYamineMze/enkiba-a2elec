<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_card_vertical_default"
    android:layout_marginHorizontal="@dimen/margin_small"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/primary_green_dark"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ID VENTE -->
        <TextView
            android:id="@+id/tvSaleId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Vente n° 12"
            android:textStyle="bold"
            android:textColor="@color/primary_green_dark"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvDiscountBadge"/>

        <!-- BADGE ROUGE (Négociation) -->
        <TextView
            android:id="@+id/tvDiscountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIX NÉGOCIÉ"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_badge_red_outline"
            android:visibility="gone"
            tools:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/tvSaleId"/>

        <!-- TOTAL -->
        <LinearLayout
            android:id="@+id/layoutTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvSaleId">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_money"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/content_desc_sale_amount"/>

            <TextView
                android:id="@+id/tvSaleTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Total : 25 000 KMF"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- PAIEMENT -->
        <TextView
            android:id="@+id/tvSalePayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Paiement : Espèces"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutTotal"/>

        <!-- VENDEUR -->
        <LinearLayout
            android:id="@+id/layoutUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvSalePayment">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_user"
                app:tint="@color/primary_green_dark"/>

            <TextView
                android:id="@+id/tvSaleUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Vendu par : Admin"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- DATE -->
        <TextView
            android:id="@+id/tvSaleDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="15/02/2025 13:54"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutUser"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>