<?xml version="1.0" encoding="utf-8"?>
<!-- Détail d'un devis : informations, client, lignes, actions -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".activities.QuoteDetailsActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_green_dark"
        android:paddingHorizontal="@dimen/padding_default"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white"
            android:contentDescription="@string/content_desc_back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_quote_details"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/padding_default" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_fields">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="@dimen/margin_fields"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:padding="@dimen/padding_default"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvQuoteRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Devis DEV-3F2A9C1B"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/primary_green_dark"/>

                    <TextView
                        android:id="@+id/tvQuoteStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Statut : Brouillon"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvQuoteDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Date : 16/10/2026 12:00"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvQuoteValidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Valable jusqu'au : 2026-11-15"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvQuoteSeller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Établi par : Manager"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvQuoteClient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Client : Ali Said"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvQuoteSale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Vente : #9A1B2C3D"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="14sp"
                        android:textColor="@color/primary_green_dark"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvQuoteTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Total : 15 000 KMF"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green_dark"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="16sp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:text="@string/section_title_items"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginBottom="@dimen/margin_small"
                android:textColor="@color/primary_green_dark"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerQuoteItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_sale_item" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuoteConvert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_fields"
                android:text="@string/btn_quote_convert"
                app:backgroundTint="@color/primary_green_dark"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuotePdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/btn_quote_pdf"/>

            <LinearLayout
                android:id="@+id/layoutQuoteStatusActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuoteAccept"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:text="@string/btn_quote_accept"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuoteReject"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_quote_reject"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuoteDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:textColor="@android:color/holo_red_dark"
                android:text="@string/btn_quote_delete"/>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottom_nav"
        layout="@layout/_nav_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
